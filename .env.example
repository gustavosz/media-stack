# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN (.env.example)
# Copia este archivo a .env y ajusta los valores a tu entorno:
#   cp .env.example .env
# ==============================================================================

# Permisos de usuario del host (en macOS suele ser PUID=501, PGID=20)
PUID=501
PGID=20
TZ=America/Argentina/Mendoza

# Directorio donde se guardan las configuraciones de los servicios (relativo o absoluto)
CONFIG_DIR=./config

# Directorio raíz en tu disco donde se guardarán los medios y descargas (/data/media, /data/torrents)
# Ejemplo en macOS con disco externo: /Volumes/Media/data
DATA_DIR=/Volumes/Media/data

# Punto de montaje del disco externo (Opcional - se auto-detecta a partir de DATA_DIR si está en /Volumes/)
# EXTERNAL_DISK_MOUNT=/Volumes/Media

# Ruta raíz del proyecto (Opcional - los scripts la detectan automáticamente)
# PROJECT_DIR=/ruta/a/media-stack

# ==============================================================================
# CONFIGURACIÓN PROTONVPN (GLUETUN)
# ==============================================================================
VPN_SERVICE_PROVIDER=protonvpn
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=your_private_key_here
WIREGUARD_ADDRESSES=10.2.0.2/32
SERVER_COUNTRIES=Argentina
VPN_PORT_FORWARDING=on
VPN_PORT_FORWARDING_PROVIDER=protonvpn

# ==============================================================================
# OPTIMIZACIÓN DE DESCARGAS QBITTORRENT (Opcional - Valores por defecto óptimos)
# ==============================================================================
# Límite de subida en bytes/s (1048576 = 1 MB/s) para evitar saturar el canal de subida
# QBIT_UP_LIMIT_BYTES=1048576
# QBIT_MAX_ACTIVE_DOWNLOADS=5
# QBIT_MAX_ACTIVE_TORRENTS=10
